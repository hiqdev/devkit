# This project's own tools and tasks; devkit's are in .config/mise/conf.d/devkit.toml, mise merges both.
# devkit writes it once and leaves it to the project.
[%- if uwiki != 'checkout' %]

[tools]
"pipx:hiqsol/uwiki" = "v[[ uwiki.lstrip("v") ]]"   # the wiki tool lint runs; bump: mise use pipx:hiqsol/uwiki@vX
[%- endif %]
