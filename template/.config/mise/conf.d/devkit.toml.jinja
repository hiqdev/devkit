# Managed by devkit (github.com/hiqdev/devkit): `devkit update` rewrites it, change the template instead.
# mise merges it with mise.toml, which holds the project's own tools and tasks, uwiki among them; a task
# there overrides devkit's of the same name. `mise tasks` lists both, `mise tasks --hidden` the devkit:*
# helpers in .config/mise/tasks/devkit, which these tasks run. Nothing here needs the devkit command.
[%- set venv = uwiki == 'checkout' %]

[tools]
uv = "0.13.8"                             # runs the devkit:* Python helpers
hk = "2.12.0"
node = "24"                               # for markdownlint-cli2
"npm:markdownlint-cli2" = "0.24.1"
typos = "1.52.2"
lychee = "0.24.2"
vale = "3.27.0"
gitleaks = "8.30.1"
shellcheck = "0.11.0"
[%- if python %]
ruff = "0.17.4"
[%- endif %]
[%- if uwiki != 'checkout' %]

[settings]
# uwiki is ours: lint takes its release the day it is out, without mise's 24h minimum_release_age
minimum_release_age_excludes = ["pipx:hiqsol/uwiki"]
[%- endif %]

[env]
HK_MISE = "1"                             # git hooks run hk through mise, with the tools above
# the answers the devkit:* scripts take: the folder uwiki reads pages from, which devkit:files lists[% if releases == 'python' %];
# the file of __version__ = "X.Y.Z" bump changes, the branch release pushes, the package up installs
# and the command whose --version it checks[% endif %]
DEVKIT_VAULT = "[[ vault ]]"
[%- if releases == 'python' %]
DEVKIT_VERSION_FILE = "[[ version_file ]]"
DEVKIT_BRANCH = "[[ branch ]]"
DEVKIT_PACKAGE = "[[ package ]]"
DEVKIT_COMMAND = "[[ command ]]"
[%- endif %]
[%- if venv %]
_.path = ["{{config_root}}/.venv/bin"]    # lint runs this checkout's uwiki, `mise run venv` installs it

[tasks.venv]
description = "install this checkout's uwiki into .venv, editable"
run = "uv sync -q"
[%- endif %]

# lint and fix take what git sees and the pages uwiki reads, gitignored ones too: devkit:files lists them
[tasks.lint]
[%- if venv %]
depends = ["venv"]
[%- endif %]
description = "pages: uwiki check, markdownlint, typos, Vale; repo: hygiene, shellcheck, gitleaks"
run = "mise run -q devkit:files | hk check --files0-from -"

[tasks.fix]
[%- if venv %]
depends = ["venv"]
[%- endif %]
description = "fix what markdownlint, the hygiene steps and the project's fixable steps can; typos only reports"
run = "mise run -q devkit:files | hk fix --files0-from -"

[tasks.links]
[%- if venv %]
depends = ["venv"]
[%- endif %]
description = "external links alive, lychee over the pages uwiki reads; network, not a gate"
run = "mise run -q devkit:files | hk run links --files0-from -"

[tasks.secrets]
description = "gitleaks over the whole git history, a leak stays there after its fix"
run = "hk run secrets --all"

[tasks.hooks]
[%- if venv %]
depends = ["venv"]
[%- endif %]
description = "install the git pre-commit hook: checks staged files, rewrites nothing"
run = "hk install --mise"
[%- if releases == 'python' %]

# releases of [[ version_file ]]: devkit:bump runs the test task (mise.toml has it) first
[tasks.patch]
description = "fixes: 0.2.1 -> 0.2.2, tagged"
run = "mise run -q devkit:bump patch"
[tasks.minor]
description = "features: 0.2.1 -> 0.3.0, tagged"
run = "mise run -q devkit:bump minor"
[tasks.major]
description = "0.2.1 -> 1.0.0, tagged"
run = "mise run -q devkit:bump major"

[tasks.release]
description = "push [[ branch ]] and the tag at once, CI publishes the release"
run = "mise run -q devkit:release"

[tasks.up]
description = "install the tagged version with mise, it becomes latest locally"
run = "mise run -q devkit:up"

[tasks.clean]
description = "remove dist, build and __pycache__ folders, those of .venv and other dot folders left alone"
run = "rm -rf dist build && find . -path './.*' -prune -o -name __pycache__ -type d -prune -exec rm -rf {} +"
[%- endif %]
